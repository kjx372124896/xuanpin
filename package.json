{
  "name": "selection-tool",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @selection/api --filter @selection/web dev",
    "dev:api": "pnpm --filter @selection/api dev",
    "dev:web": "pnpm --filter @selection/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm exec prisma generate --schema prisma/schema.prisma",
    "db:migrate": "pnpm exec prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "pnpm exec prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @selection/api seed",
    "db:studio": "pnpm exec prisma studio --schema prisma/schema.prisma",
    "test:parser": "pnpm --filter @selection/api test"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "@types/node": "^24.10.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}

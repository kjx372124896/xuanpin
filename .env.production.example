NODE_ENV=production
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=https://your-domain.example.com
COOKIE_SECURE=true
TRUST_PROXY=1
UPLOAD_DIR=./apps/api/storage/uploads

# 部署程序会自动创建以下数据库账号和数据库；新账号的 POSTGRES_PASSWORD 留空时自动生成并写回 .env。已有账号请填写原密码。
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=

# 本机 PostgreSQL 默认通过 postgres 系统账号执行创建，不需要填写管理连接。
# 远程 PostgreSQL 才填写管理连接，例如 postgresql://postgres:管理密码@数据库地址:5432/postgres?sslmode=require
POSTGRES_ADMIN_URL=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-8-characters
ADMIN_NAME=超级管理员
# 必须是64位十六进制字符；更换后将无法解密此前保存的达摩盘凭证。
DMP_CREDENTIAL_ENCRYPTION_KEY=
DMP_EXTENSION_ID=nggbkgocgdebofoppmjjfoobhblppicf

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE

  @@map("用户角色")
}

enum EmploymentStatus {
  ACTIVE
  RESIGNED
  SUSPENDED

  @@map("员工状态")
}

enum AccountStatus {
  ACTIVE
  DISABLED

  @@map("账号状态")
}

enum ImportBatchStatus {
  PREVIEW
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("导入批次状态")
}

enum ImportFileStatus {
  PREVIEW
  DUPLICATE
  PROCESSING
  COMPLETED
  FAILED

  @@map("导入文件状态")
}

model Product {
  productId            String            @id @map("商品ID") @db.VarChar(80)
  productName          String            @map("商品名称") @db.Text
  productUrl           String?           @map("商品链接") @db.Text
  shopName             String?           @map("店铺名称") @db.VarChar(255)
  shopType             String?           @map("店铺类型") @db.VarChar(80)
  imageUrl             String?           @map("商品图片链接") @db.Text
  latestCategory       String?           @map("最新类目名称") @db.VarChar(255)
  latestCategoryLevel1 String?           @map("最新一级类目") @db.VarChar(255)
  latestCategoryLevel2 String?           @map("最新二级类目") @db.VarChar(255)
  firstWeekStart       DateTime?         @map("首次上榜日期") @db.Date
  latestWeekStart      DateTime?         @map("最近上榜日期") @db.Date
  latestWeekEnd        DateTime?         @map("最近上榜结束日期") @db.Date
  latestRank           Int?              @map("最近行业排名")
  historyWeekCount     Int               @default(0) @map("历史上榜周数")
  historyRecordCount   Int               @default(0) @map("历史记录条数")
  consecutiveWeekCount Int               @default(0) @map("连续上榜周数")
  latestVisitorRaw     String?           @map("最新访客数原值") @db.VarChar(100)
  latestVisitorMin     Decimal?          @map("最新访客数下限") @db.Decimal(20, 2)
  latestVisitorMax     Decimal?          @map("最新访客数上限") @db.Decimal(20, 2)
  latestVisitorMedian  Decimal?          @map("最新访客数中值") @db.Decimal(20, 2)
  latestBuyerRaw       String?           @map("最新支付买家数原值") @db.VarChar(100)
  latestBuyerMin       Decimal?          @map("最新支付买家数下限") @db.Decimal(20, 2)
  latestBuyerMax       Decimal?          @map("最新支付买家数上限") @db.Decimal(20, 2)
  latestBuyerMedian    Decimal?          @map("最新支付买家数中值") @db.Decimal(20, 2)
  latestCartRaw        String?           @map("最新加购人数原值") @db.VarChar(100)
  latestCartMin        Decimal?          @map("最新加购人数下限") @db.Decimal(20, 2)
  latestCartMax        Decimal?          @map("最新加购人数上限") @db.Decimal(20, 2)
  latestCartMedian     Decimal?          @map("最新加购人数中值") @db.Decimal(20, 2)
  aiPreviousSales      String?           @map("上期销售额") @db.Text
  aiSales              String?           @map("销售额") @db.Text
  aiClickRate          String?           @map("点击率") @db.Text
  aiConversionRate     String?           @map("转化率") @db.Text
  aiAddToCartRate      String?           @map("加购率") @db.Text
  aiAddToCartCost      String?           @map("加购成本") @db.Text
  aiRoi                String?           @map("投产比") @db.Text
  aiUnitPrice          String?           @map("件单价") @db.Text
  aiSpend              String?           @map("花费") @db.Text
  aiCpc                String?           @map("CPC") @db.Text
  aiMetricsFetchedAt   DateTime?         @map("AI数据获取时间")
  createdAt            DateTime          @default(now()) @map("创建时间")
  updatedAt            DateTime          @updatedAt @map("更新时间")
  histories            ProductHistory[]
  favorites            ProductFavorite[]

  @@index([productName])
  @@index([shopName])
  @@index([latestCategory, latestWeekStart])
  @@index([latestCategoryLevel1, latestCategoryLevel2])
  @@index([aiMetricsFetchedAt])
  @@map("商品主表")
}

model ProductHistory {
  id              String      @id @default(cuid()) @map("历史记录ID") @db.VarChar(30)
  productId       String      @map("商品ID") @db.VarChar(80)
  weekStart       DateTime    @map("周开始日期") @db.Date
  weekEnd         DateTime    @map("周结束日期") @db.Date
  rawPeriod       String      @map("原始日期范围") @db.VarChar(80)
  categoryName    String      @map("类目名称") @db.VarChar(255)
  categoryLevel1  String      @map("一级类目") @db.VarChar(255)
  categoryLevel2  String?     @map("二级类目") @db.VarChar(255)
  rank            Int?        @map("行业排名")
  trend           String?     @map("趋势") @db.VarChar(80)
  visitorRaw      String?     @map("访客数原值") @db.VarChar(100)
  visitorMin      Decimal?    @map("访客数下限") @db.Decimal(20, 2)
  visitorMax      Decimal?    @map("访客数上限") @db.Decimal(20, 2)
  visitorMedian   Decimal?    @map("访客数中值") @db.Decimal(20, 2)
  buyerRaw        String?     @map("支付买家数原值") @db.VarChar(100)
  buyerMin        Decimal?    @map("支付买家数下限") @db.Decimal(20, 2)
  buyerMax        Decimal?    @map("支付买家数上限") @db.Decimal(20, 2)
  buyerMedian     Decimal?    @map("支付买家数中值") @db.Decimal(20, 2)
  cartRaw         String?     @map("加购人数原值") @db.VarChar(100)
  cartMin         Decimal?    @map("加购人数下限") @db.Decimal(20, 2)
  cartMax         Decimal?    @map("加购人数上限") @db.Decimal(20, 2)
  cartMedian      Decimal?    @map("加购人数中值") @db.Decimal(20, 2)
  exportTime      DateTime?   @map("导出时间")
  sourceFileId    String?     @map("来源文件ID") @db.VarChar(30)
  sourceFileName  String?     @map("来源文件名") @db.Text
  sourceRowNumber Int?        @map("来源行号")
  importedAt      DateTime    @default(now()) @map("导入时间")
  product         Product     @relation(fields: [productId], references: [productId], onDelete: Cascade)
  sourceFile      ImportFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@unique([productId, weekStart, categoryName], map: "商品上榜历史_业务唯一键")
  @@index([productId, weekStart])
  @@index([categoryLevel1, categoryLevel2])
  @@index([weekStart, categoryName, rank])
  @@map("商品上榜历史表")
}

model Category {
  id             String   @id @default(cuid()) @map("类目ID") @db.VarChar(30)
  categoryName   String   @unique @map("类目名称") @db.VarChar(255)
  categoryLevel1 String   @map("一级类目") @db.VarChar(255)
  categoryLevel2 String?  @map("二级类目") @db.VarChar(255)
  enabled        Boolean  @default(true) @map("是否启用")
  createdAt      DateTime @default(now()) @map("创建时间")
  updatedAt      DateTime @updatedAt @map("更新时间")

  @@index([categoryLevel1, categoryLevel2])
  @@map("类目表")
}

model ImportBatch {
  id               String            @id @default(cuid()) @map("批次ID") @db.VarChar(30)
  operatorId       String?           @map("操作人ID") @db.VarChar(30)
  status           ImportBatchStatus @default(PREVIEW) @map("批次状态")
  totalFiles       Int               @default(0) @map("总文件数")
  totalRows        Int               @default(0) @map("总数据行数")
  importedRows     Int               @default(0) @map("成功入库行数")
  duplicateRows    Int               @default(0) @map("重复行数")
  errorRows        Int               @default(0) @map("失败行数")
  newProducts      Int               @default(0) @map("新增商品数")
  createdHistories Int               @default(0) @map("新增历史记录数")
  updatedHistories Int               @default(0) @map("更新历史记录数")
  errorSummary     String?           @map("错误摘要") @db.Text
  createdAt        DateTime          @default(now()) @map("上传时间")
  startedAt        DateTime?         @map("开始时间")
  completedAt      DateTime?         @map("完成时间")
  files            ImportFile[]

  @@index([status, createdAt])
  @@map("导入批次表")
}

model ImportFile {
  id            String           @id @default(cuid()) @map("文件记录ID") @db.VarChar(30)
  batchId       String           @map("批次ID") @db.VarChar(30)
  originalName  String           @map("原始文件名") @db.Text
  sha256        String           @map("文件SHA256") @db.Char(64)
  fileSize      BigInt           @map("文件大小")
  sheetName     String?          @map("工作表名称") @db.VarChar(255)
  weekStart     DateTime?        @map("周开始日期") @db.Date
  weekEnd       DateTime?        @map("周结束日期") @db.Date
  categoryName  String?          @map("类目名称") @db.VarChar(255)
  rowCount      Int              @default(0) @map("原始数据行数")
  importedCount Int              @default(0) @map("成功行数")
  errorCount    Int              @default(0) @map("失败行数")
  status        ImportFileStatus @default(PREVIEW) @map("文件状态")
  storagePath   String           @map("存储路径") @db.Text
  sourceName    String?          @map("合并来源文件名") @db.Text
  errorsJson    String?          @map("错误明细") @db.Text
  batch         ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  histories     ProductHistory[]

  @@index([sha256])
  @@index([batchId, status])
  @@map("导入文件表")
}

model User {
  id                 String              @id @default(cuid()) @map("用户ID") @db.VarChar(30)
  username           String              @unique @map("登录账号") @db.VarChar(80)
  passwordHash       String              @map("密码哈希") @db.VarChar(255)
  name               String              @map("员工姓名") @db.VarChar(100)
  employeeNo         String?             @unique @map("员工编号") @db.VarChar(80)
  department         String?             @map("所属部门") @db.VarChar(120)
  role               UserRole            @default(EMPLOYEE) @map("用户角色")
  employmentStatus   EmploymentStatus    @default(ACTIVE) @map("员工状态")
  accountStatus      AccountStatus       @default(ACTIVE) @map("账号状态")
  canImport          Boolean             @default(false) @map("允许导入")
  createdAt          DateTime            @default(now()) @map("创建时间")
  updatedAt          DateTime            @updatedAt @map("更新时间")
  sessions           LoginSession[]
  favorites          ProductFavorite[]
  dmpCredential      DmpCredential?
  dmpAiRuns          DmpAiRun[]
  dmpExtensionLink   DmpExtensionLink?
  dmpCollectionTasks DmpCollectionTask[] @relation("DmpCollectionTaskCreator")

  @@index([role, accountStatus, employmentStatus])
  @@map("系统用户表")
}

model LoginSession {
  id        String   @id @default(cuid()) @map("会话ID") @db.VarChar(30)
  userId    String   @map("用户ID") @db.VarChar(30)
  tokenHash String   @unique @map("会话令牌哈希") @db.Char(64)
  expiresAt DateTime @map("过期时间")
  createdAt DateTime @default(now()) @map("创建时间")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("登录会话表")
}

model ProductFavorite {
  userId    String   @map("用户ID") @db.VarChar(30)
  productId String   @map("商品ID") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("收藏时间")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("商品收藏表")
}

model IpWhitelist {
  id        String   @id @default(cuid()) @map("规则ID") @db.VarChar(30)
  cidr      String   @unique @map("IP或网段") @db.VarChar(100)
  label     String   @map("备注") @db.VarChar(120)
  enabled   Boolean  @default(true) @map("是否启用")
  createdAt DateTime @default(now()) @map("创建时间")
  updatedAt DateTime @updatedAt @map("更新时间")

  @@map("公司IP白名单表")
}

model DmpCredential {
  id               String    @id @default(cuid()) @map("授权ID") @db.VarChar(30)
  userId           String    @unique @map("用户ID") @db.VarChar(30)
  encryptedPayload String    @map("加密凭证") @db.Text
  lastStatus       String    @default("NOT_TESTED") @map("最近验证状态") @db.VarChar(30)
  lastCheckedAt    DateTime? @map("最近验证时间")
  lastError        String?   @map("最近错误") @db.VarChar(300)
  createdAt        DateTime  @default(now()) @map("创建时间")
  updatedAt        DateTime  @updatedAt @map("更新时间")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("达摩盘授权表")
}

model DmpExtensionLink {
  id                      String    @id @default(cuid()) @map("扩展绑定ID") @db.VarChar(30)
  userId                  String    @unique @map("用户ID") @db.VarChar(30)
  pairingCodeHash         String?   @unique @map("配对码哈希") @db.Char(64)
  pairingExpiresAt        DateTime? @map("配对码过期时间")
  extensionTokenHash      String?   @unique @map("扩展令牌哈希") @db.Char(64)
  extensionTokenExpiresAt DateTime? @map("扩展令牌过期时间")
  lastSeenAt              DateTime? @map("扩展最近在线时间")
  lastSyncAt              DateTime? @map("最近同步时间")
  lastStatus              String    @default("NOT_PAIRED") @map("扩展状态") @db.VarChar(30)
  lastError               String?   @map("最近错误") @db.VarChar(300)
  createdAt               DateTime  @default(now()) @map("创建时间")
  updatedAt               DateTime  @updatedAt @map("更新时间")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("达摩盘浏览器扩展绑定表")
}

model DmpAiRun {
  id             String   @id @default(cuid()) @map("任务ID") @db.VarChar(30)
  userId         String   @map("用户ID") @db.VarChar(30)
  clientRunId    String   @map("客户端任务ID") @db.VarChar(100)
  batchNumber    Int      @map("批次序号")
  productIdsJson String   @map("商品ID列表") @db.Text
  sessionId      String?  @map("达摩盘会话ID") @db.VarChar(120)
  status         String   @default("CREATED") @map("任务状态") @db.VarChar(30)
  markdown       String?  @map("AI返回Markdown") @db.Text
  errorMessage   String?  @map("错误信息") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("创建时间")
  updatedAt      DateTime @updatedAt @map("更新时间")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientRunId])
  @@index([userId, createdAt])
  @@map("达摩盘AI任务表")
}

model DmpCollectionTask {
  id               String               @id @default(cuid()) @map("任务ID") @db.VarChar(30)
  createdById      String               @map("创建管理员ID") @db.VarChar(30)
  title            String               @map("任务名称") @db.VarChar(255)
  status           String               @default("QUEUED") @map("任务状态") @db.VarChar(30)
  productIdsJson   String               @map("商品ID列表") @db.Text
  totalProducts    Int                  @default(0) @map("商品总数")
  totalBatches     Int                  @default(0) @map("批次总数")
  completedBatches Int                  @default(0) @map("完成批次数")
  failedBatches    Int                  @default(0) @map("失败批次数")
  savedProducts    Int                  @default(0) @map("已入库商品数")
  lastError        String?              @map("最近错误") @db.Text
  createdAt        DateTime             @default(now()) @map("创建时间")
  startedAt        DateTime?            @map("开始时间")
  completedAt      DateTime?            @map("完成时间")
  updatedAt        DateTime             @updatedAt @map("更新时间")
  createdBy        User                 @relation("DmpCollectionTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  batches          DmpCollectionBatch[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@map("达摩盘采集任务表")
}

model DmpCollectionBatch {
  id                       String            @id @default(cuid()) @map("批次ID") @db.VarChar(30)
  taskId                   String            @map("任务ID") @db.VarChar(30)
  batchNumber              Int               @map("批次序号")
  productIdsJson           String            @map("商品ID列表") @db.Text
  clientRunId              String            @unique @map("客户端任务ID") @db.VarChar(100)
  previousClientRunIdsJson String            @default("[]") @map("历史客户端任务ID") @db.Text
  status                   String            @default("QUEUED") @map("批次状态") @db.VarChar(30)
  attempts                 Int               @default(0) @map("执行次数")
  recoveryCount            Int               @default(0) @map("恢复查询次数")
  savedProducts            Int               @default(0) @map("已入库商品数")
  nextAttemptAt            DateTime          @default(now()) @map("下次执行时间")
  lastError                String?           @map("最近错误") @db.Text
  startedAt                DateTime?         @map("开始时间")
  completedAt              DateTime?         @map("完成时间")
  createdAt                DateTime          @default(now()) @map("创建时间")
  updatedAt                DateTime          @updatedAt @map("更新时间")
  task                     DmpCollectionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, batchNumber])
  @@index([status, nextAttemptAt])
  @@index([taskId, status])
  @@map("达摩盘采集批次表")
}
